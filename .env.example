# Copy to .env (never commit .env). Real environment variables take precedence.

# Required for image/PDF reading and any later LLM stage
GEMINI_API_KEY=

# Models (verify the current ids in Google AI Studio; these are only defaults)
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Parallel Gemini requests during vision extraction
GEMINI_CONCURRENCY=4

# USD per 1M tokens, used only for the cost estimate in usage reports
GEMINI_PRICE_INPUT_PER_M=0.30
GEMINI_PRICE_OUTPUT_PER_M=2.50
